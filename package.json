{
	"name": "verski-app",
	"private": true,
	"version": "0.1.0",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test",
		"build:translation:engwebp": "node --experimental-strip-types scripts/translation/build-engwebp.ts",
		"build:translation:polubg": "node --experimental-strip-types scripts/translation/build-polubg.ts",
		"build:pwa-icons": "node --experimental-strip-types scripts/pwa/generate-icons.ts",
		"build:translation:catalog": "node --experimental-strip-types scripts/translation/build-translation-catalog.ts",
		"build:translations": "npm run build:translation:engwebp && npm run build:translation:polubg && npm run build:translation:catalog",
		"machine-translate": "inlang machine translate --project project.inlang"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@inlang/cli": "^3.0.0",
		"@inlang/paraglide-js": "^2.24.1",
		"@playwright/test": "^1.60.0",
		"@resvg/resvg-js": "^2.6.2",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^22",
		"@vitest/browser-playwright": "^4.1.8",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"dependencies": {
		"@fontsource/instrument-serif": "^5.3.0",
		"@fontsource/lora": "^5.3.0",
		"@fontsource/work-sans": "^5.3.0",
		"@lucide/svelte": "^1.31.0",
		"@picocss/pico": "^2.1.1",
		"zod": "^4.4.3"
	}
}
